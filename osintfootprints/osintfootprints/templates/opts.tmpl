<%include file="HEADER.tmpl"/>
<script type='text/javascript' src='${docroot}/static/js/osintfootprints.opts.js'></script>

<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 20px;">
  <h2 style="margin:0; color:var(--accent-teal);">Settings</h2>
  
  <form class="form-inline" action='${docroot}/savesettings' id="savesettingsform" method='POST' enctype="multipart/form-data">
    <div class="action-toolbar">
      <input type=hidden id='allopts' name='allopts' value=''>
      <input type=hidden id='token' name='token' value="${token}">
      <input type="file" name='configFile' id="configFile" class='hidden' onChange='$("#savesettingsform").submit()' />
      
      <button id="btn-import-config" class='btn btn-info' type="button">Import API Keys</button>
      <button id="btn-opt-export" class='btn btn-info' type="button">Export API Keys</button>
      <button id="btn-reset-settings" class='btn btn-danger' type="button">Reset</button>
      <button id="btn-save-changes" class='btn btn-primary' type="submit">Save Changes</button>
    </div>
</div>

% if updated:
<div class="alert alert-success" style="background:rgba(16,185,129,0.1); border-color:#10b981; color:#10b981;">
 <button type="button" class="close" data-dismiss="alert" style="color:#10b981;">&times;</button>
 <h4>Success!</h4>
 Settings updated. These will take effect the next time you run a scan.
</div>
% endif

<div class="row">
  <div class="col-md-3">
    <div class="glass-card" style="padding:15px 0;">
      <h4 style="margin: 0 15px 15px 15px; font-size:12px; text-transform:uppercase; color:var(--text-muted); letter-spacing:1px;">Modules Configuration</h4>
      <ul class="nav nav-pills nav-stacked">
        <li id='tab_global' class="active"><a href="#">Global Settings</a></li>
        % for mod in sorted(opts['__modules__'].keys()):
            <% keylist = dict((k, v) for k, v in opts['__modules__'][mod]['opts'].items() if not k.startswith('_')) %>
            % if len(keylist) > 0:
                <% keyicon = "" %>
                <% apikeylist = dict((k, v) for k, v in opts['__modules__'][mod]['opts'].items() if k.find("api_key") >= 0) %>
                <% 
                if len(apikeylist) > 0: 
                    keyicon = "&nbsp;&nbsp;<i class=\"glyphicon glyphicon-lock\" style=\"color:#f59e0b; float:right; margin-top:2px;\"></i>"
                %>
                <li id='tab_${mod}'><a href='#' onclick='switchTab("${mod}");'>${opts['__modules__'][mod]['name']}${keyicon}</a></li>
            % endif
        % endfor
      </ul>
    </div>
  </div>

  <div class="col-md-9">
    <div class="tab-content glass-card" style="min-height: 500px;">
      
      <div id='optsect_global' class="tab-pane active">
        <h4 style="color:var(--accent-teal); border-bottom:1px solid var(--border-color); padding-bottom:10px; margin-bottom:20px;">Global Settings</h4>
        <table class='table table-hover'>
          <thead><tr><th>Option</th> <th>Value</th></tr></thead>
          <tbody>
          % for opt in sorted(opts.keys()):
              % if not opt.startswith("__"):
              <tr>
                <td style="width:50%;"><span style="color:var(--text-main); font-weight:500;">${opts['__globaloptdescs__'].get(opt) or "No description available"}</span><br/><span style="font-size:11px; color:var(--text-muted);">${opt}</span></td>
                <td style='vertical-align: middle'>
                  % if type(opts[opt]) is int:
                  <div class='form-group' style="margin-bottom:0;">
                      <input id='${opt}' class='form-control' type=text value="${opts[opt]}" style="max-width:200px;">
                  </div>
                  % endif
                  % if type(opts[opt]) is str:
                  <div class='form-group' style="margin-bottom:0;">
                      <input id='${opt}' class='form-control' type=text value="${opts[opt]}" style="max-width:400px;">
                  </div>
                  % endif
                  % if type(opts[opt]) is bool:
                  <%
                      if opts[opt] == True:
                          seltrue = "selected"
                          selfalse = ""
                      else:
                          selfalse = "selected"  
                          seltrue = ""
                  %>
                      <select id='${opt}' class='form-control' style="max-width:150px;">
                          <option value=1 ${seltrue}>True</option>
                          <option value=0 ${selfalse}>False</option>
                      </select>
                  % endif
                  % if type(opts[opt]) is list and type(opts[opt][0]) is str:
                      <% expandedopt = ','.join(opts[opt]) %>
                      <div class='form-group' style="margin-bottom:0;">
                          <input id='${opt}' class='form-control' type=text value="${expandedopt}" style="max-width:400px;">
                      </div>
                  % endif
                  % if type(opts[opt]) is list and type(opts[opt][0]) is int:
                      <% expandedopt = ','.join(str(x) for x in opts[opt]) %>
                      <div class='form-group' style="margin-bottom:0;">
                          <input id='${opt}' class='form-control' type=text value="${expandedopt}" style="max-width:200px;">
                      </div>
                  % endif
                </td>
              </tr>
              % endif
          % endfor
          </tbody>
        </table>
      </div>

      % for mod in sorted(opts['__modules__'].keys()):
          <%
              summary = opts['__modules__'][mod].get('descr') or 'No summary available.'
              categories = opts['__modules__'][mod].get('cats') or []
              labels = opts['__modules__'][mod].get('labels') or []
              meta = opts['__modules__'][mod].get('meta')
              modopts = opts['__modules__'][mod].get('opts')
              optdescs = opts['__modules__'][mod].get('optdescs')
              data_source = meta.get('dataSource') or {}
              website = data_source.get('website') or ''
              description = data_source.get('description') or ''
              apiKeyInstructions = data_source.get('apiKeyInstructions') or ''
          %>
          <div id='optsect_${mod}' class="tab-pane" style="display: none">
            <h4 style="color:var(--accent-teal); border-bottom:1px solid var(--border-color); padding-bottom:10px; margin-bottom:20px;">${opts['__modules__'][mod]['name']} <small style="color:var(--text-muted);">(${mod})</small></h4>

            <div style="background:rgba(255,255,255,0.02); padding:15px; border-radius:6px; margin-bottom:20px; border:1px solid var(--border-color);">
              <p style="margin-bottom:10px;"><strong>Summary:</strong> <span style="color:var(--text-muted);">${summary}</span></p>
              % if description:
                <p style="margin-bottom:10px; color:var(--text-muted);">${description}</p>
              % endif
              % if categories:
                <p style="margin-bottom:5px;"><strong>Categories:</strong> <span class="badge" style="background:var(--accent-navy);">${', '.join(categories)}</span></p>
              % endif
              % if labels:
                <p style="margin-bottom:5px;"><strong>Tags:</strong> <span class="badge" style="background:var(--accent-navy);">${', '.join(labels)}</span></p>
              % endif
              % if website:
                <p style="margin-bottom:0;"><strong>Website:</strong> <a href="${website}" target="_blank" style="color:var(--accent-teal);">${website}</a></p>
              % endif
            </div>

            <h5 style="margin-bottom:15px; color:var(--text-main); font-weight:600;">Configuration Options</h5>
            <table class='table table-hover'>
              <thead><tr><th>Option</th> <th>Value</th></tr></thead>
              <tbody>
              % for opt in sorted(modopts.keys()):
                  % if not opt.startswith("_"):
                      <tr>
                        <td style="width:50%;">
                          <span style="color:var(--text-main); font-weight:500;">${optdescs.get(opt) or "No description available."}</span><br/>
                          <span style="font-size:11px; color:var(--text-muted);">${opt}</span>
                          % if "api_key" in opt:
                              % if apiKeyInstructions:
                                  <%
                                      import re
                                      instructions = ""
                                      for step in apiKeyInstructions:
                                          if "https://" in step or "http://" in step:
                                              step = re.sub(r'(https?://.[^ ]+)', '<a target=_new href=\'\\1\'>\\1</a>', step)
                                          instructions += f"<li>{step}</li>"
                                  %>
                                  <a href='#' data-html="true" data-toggle="popover" data-trigger="focus" title="Instructions" data-content="<ol>${instructions}</ol>" style="margin-left:5px;"><i class="glyphicon glyphicon-question-sign" style="color:var(--accent-teal);"></i></a>
                              % endif
                          % endif
                        </td>
                        <td style='vertical-align: middle'>
                      % if type(modopts[opt]) is int:
                          <div class='form-group' style="margin-bottom:0;">
                              <input id='${mod}:${opt}' class='form-control' type=text value="${modopts[opt]}" style="max-width:200px;">
                          </div>
                      % endif
                      % if type(modopts[opt]) is str:
                          <div class='form-group' style="margin-bottom:0;">
                              <input id='${mod}:${opt}' class='form-control' type=text value="${modopts[opt]}" style="max-width:400px;">
                          </div>
                      % endif
                      % if type(modopts[opt]) is bool:
                      <%
                          if modopts[opt] == True:
                              seltrue = "selected"
                              selfalse = ""
                          else:
                              selfalse = "selected"
                              seltrue = ""
                      %>
                          <select id='${mod}:${opt}' class='form-control' style="max-width:150px;">
                              <option value=1 ${seltrue}>True</option>
                              <option value=0 ${selfalse}>False</option>
                          </select>
                      % endif
                      % if type(modopts[opt]) is list and type(modopts[opt][0]) is str:
                          <% expandedopt = ','.join(modopts[opt]) %>
                          <div class='form-group' style="margin-bottom:0;">
                              <input id='${mod}:${opt}' class='form-control' type=text value="${expandedopt}" style="max-width:400px;">
                          </div>
                      % endif
                      % if type(modopts[opt]) is list and type(modopts[opt][0]) is int:
                          <% expandedopt = ','.join(str(x) for x in modopts[opt]) %>
                          <div class='form-group' style="margin-bottom:0;">
                              <input id='${mod}:${opt}' class='form-control' type=text value="${expandedopt}" style="max-width:200px;">
                          </div>
                      % endif
                      </td></tr>
                  % endif
              % endfor
              </tbody>
            </table>
          </div>
      % endfor
    </div>
  </div>
</div>
</form>

<%include file="FOOTER.tmpl"/>
