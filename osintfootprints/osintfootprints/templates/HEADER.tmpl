          </a>
          <ul class="dropdown-menu" style="background:var(--bg-card);border:1px solid var(--border-color);">
            <li><a href="${docroot}/opts" style="color:var(--text-main);">Profile Settings</a></li>
            <li role="separator" class="divider" style="background-color:rgba(255,255,255,0.1);"></li>
            <li><a href="#" style="color:#ef4444;">Logout</a></li>
          </ul>
        </li>
