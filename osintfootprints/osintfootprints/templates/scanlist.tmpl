<%include file="HEADER.tmpl"/>
<script>
  // Show sidebar for this page
  $(document).ready(function() {
    $('.sidebar').show();
  });
</script>
<div class="sidebar" style="display:none; position:fixed; left:0; top:70px; bottom:0; width:250px; z-index:100; border-right:1px solid var(--border-color); padding:20px; background:var(--bg-card);">
  <h4 style="margin-bottom:20px;color:var(--accent-teal);font-size:14px;text-transform:uppercase;letter-spacing:1px;">Filters</h4>
  <ul class="nav nav-pills nav-stacked" id="sidebar-filters">
    <li class="active"><a href='javascript:filter("all")'>All Scans</a></li>
    <li><a href='javascript:filter("running")'>Running</a></li>
    <li><a href='javascript:filter("finished")'>Finished</a></li>
    <li><a href='javascript:filter("failed")'>Failed/Aborted</a></li>
  </ul>
  <hr style="border-color:rgba(255,255,255,0.1); margin: 20px 0;"/>
  <h4 style="margin-bottom:20px;color:var(--accent-teal);font-size:14px;text-transform:uppercase;letter-spacing:1px;">Actions</h4>
  <button id="sidebar-btn-export" class="btn btn-info btn-block" style="margin-bottom:10px;">Export Selected</button>
  <button id="sidebar-btn-delete" class="btn btn-danger btn-block">Delete Selected</button>
</div>

<div style="margin-left:250px;">
  <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 20px;">
    <h2 style="margin:0;">Scans &nbsp;<img id="loader" src="${docroot}/static/img/loader.gif" style="height:20px;display:none;"></h2>
    <div class="action-toolbar">
       <input type="text" id="scan-search" class="modern-search" placeholder="Search scans...">
       <button id="top-btn-refresh" class="btn btn-icon" title="Refresh"><i class="glyphicon glyphicon-refresh" style="color:var(--status-finished);"></i></button>
       <button id="top-btn-delete" class="btn btn-icon" title="Delete Selected"><i class="glyphicon glyphicon-trash" style="color:#ef4444;"></i></button>
    </div>
  </div>

  <div class="glass-card" id="scancontent">
  % if newscan:
  <div class="alert alert-success">
   <button type="button" class="close" data-dismiss="alert">&times;</button>
   <h4>Success!</h4>
   Scan '${newscan}' has successfully been initiated. Reload this page for up-to-date status on the scan.
  </div>
  % endif
  % if rerunscans:
  <div class="alert alert-success">
   <button type="button" class="close" data-dismiss="alert">&times;</button>
   <h4>Success!</h4>
   Scans have successfully been re-initiated as separate instances. Reload this page for up-to-date status on the scans.
  </div>
  % endif
  % if stoppedscan and len(errors) == 0:
  <div class="alert alert-warning">
   <button type="button" class="close" data-dismiss="alert">&times;</button>
   <h4>Scan aborted.</h4>
   Please allow a minute or two for the scan to cleanly shut itself down.
  </div>
  % endif

  % if stoppedscan and len(errors) > 0:
  <div class="alert alert-warning">
   <button type="button" class="close" data-dismiss="alert">&times;</button>
   <h4>Error</h4>
   Some or all of the scans could not be aborted:<br>
  <ul>
      % for err in errors:
          <li>${err}</li>
      % endfor
  </ul>
  </div>

  % endif

  <script type='text/javascript' src="${docroot}/static/js/osintfootprints.scanlist.js"></script>
  </div>
</div>

<iframe class='hidden' id='exportframe'></iframe>

<%include file="FOOTER.tmpl"/>
